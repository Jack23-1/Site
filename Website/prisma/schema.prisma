generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContentType {
  news
  documents
  gallery
}

enum ContentStatus {
  draft
  published
}

model AdminUser {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(254)
  name         String    @db.VarChar(100)
  passwordHash String
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @db.Char(64)
  csrfToken String    @db.VarChar(64)
  userId    String    @db.Uuid
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime

  @@index([expiresAt])
  @@index([userId])
}

model Content {
  id          String        @id @default(uuid()) @db.Uuid
  type        ContentType
  status      ContentStatus @default(draft)
  titleFr     String        @db.VarChar(180)
  titleEn     String        @db.VarChar(180)
  bodyFr      String        @default("")
  bodyEn      String        @default("")
  resourceUrl String        @default("") @db.VarChar(2048)
  version     Int           @default(1)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  publishedAt DateTime?

  @@index([type, status, publishedAt])
}
