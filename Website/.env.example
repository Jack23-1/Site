# Copy to .env and set a dedicated PostgreSQL database connection.
DATABASE_URL="postgresql://onip:CHANGE_ME@127.0.0.1:5432/onip?schema=public"
# Exact origin of the browser app. Use HTTPS in production.
APP_ORIGIN="http://localhost:5173"
HOST="127.0.0.1"
PORT=3001
NODE_ENV=development
# Set only when the API is behind exactly this many trusted reverse proxies.
TRUST_PROXY_HOPS=0
# Optional separate PostgreSQL database for integration tests.
# TEST_DATABASE_URL="postgresql://onip:CHANGE_ME@127.0.0.1:5432/onip_test"
